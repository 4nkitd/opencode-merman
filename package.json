{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "opencode-merman",
  "version": "0.1.1",
  "description": "Native terminal Mermaid rendering for OpenCode V2, derived from the official Merman renderer",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/4nkitd/opencode-merman.git"
  },
  "type": "module",
  "bin": {
    "opencode-merman": "./bin/cli.mjs"
  },
  "keywords": ["opencode", "opencode-v2", "mermaid", "terminal", "tui", "plugin", "diagrams"],
  "exports": {
    ".": "./src/markdown.ts",
    "./tui": "./tui.ts",
    "./markdown": "./src/markdown.ts",
    "./palette": "./src/palette.ts",
    "./plugin": "./src/plugin.ts"
  },
  "scripts": {
    "audit:layouts": "bun run script/layout-audit.ts",
    "test": "bun test --timeout 30000 --only-failures",
    "typecheck": "tsc --noEmit",
    "test:installer": "node --test script/installer-check.mjs",
    "check": "bun run typecheck && bun run test && bun run test:installer"
  },
  "dependencies": {
    "entities": "7.0.1",
    "jsonc-parser": "3.3.1",
    "string-width": "7.2.0",
    "yaml": "2.8.3"
  },
  "peerDependencies": {
    "@opencode/plugin": ">=2.0.22 <3",
    "@opentui/core": ">=0.5.14 <0.6",
    "@opentui/solid": ">=0.5.14 <0.6",
    "solid-js": "^1.9.12"
  },
  "peerDependenciesMeta": {
    "@opencode/plugin": { "optional": true },
    "@opentui/solid": { "optional": true },
    "solid-js": { "optional": true }
  },
  "devDependencies": {
    "@opencode/plugin": "2.0.22",
    "@opentui/solid": "0.5.14",
    "@tsconfig/bun": "1.0.9",
    "@types/bun": "latest",
    "solid-js": "1.9.12",
    "typescript": "^5.9.3"
  },
  "files": ["bin", "tui.ts", "src", "examples", "LICENSE", "UPSTREAM.md", "README.md"],
  "engines": {
    "node": ">=20",
    "bun": ">=1.3.0"
  }
}
